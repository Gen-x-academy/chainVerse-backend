# Copy this file to .env and adjust values:  cp .env.example .env
# Only JWT_SECRET is required; every other variable has a default.
# Keep in sync with src/config/env.validation.ts and src/config/app.config.ts.

# ─── Core ─────────────────────────────────────────────────────────────────────
# Environment: development | production | test  (default: development)
NODE_ENV=development

# Server listening port  (default: 3000)
PORT=3000

# Comma-separated list of allowed CORS origins (default: http://localhost:3000)
ALLOWED_ORIGINS=http://localhost:3000

# ─── Logging ──────────────────────────────────────────────────────────────────
# Pino log level: fatal | error | warn | info | debug | trace | silent
# Use "silent" in test environments to suppress all output.
# (default: info)
LOG_LEVEL=info

# ─── Database ─────────────────────────────────────────────────────────────────
# MongoDB connection URI  (default: mongodb://localhost:27017/chain-verse)
# Local:  mongodb://localhost:27017/chain-verse
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/chain-verse
MONGO_URI=mongodb://localhost:27017/chain-verse

# URI used by the Mongoose connection in AppModule and as a fallback by the
# health check when MONGO_URI is unset. Keep it pointing at the same database
# as MONGO_URI.  (default: mongodb://localhost:27017/chainverse)
MONGODB_URI=mongodb://localhost:27017/chain-verse

# Separate URI used only by the test runner (optional)
MONGODB_TEST_URI=mongodb://localhost:27017/chainverse_test

# Database name used by the e2e test helpers (optional, default: chainverse-test)
MONGODB_DB=chainverse-test

# ─── Authentication  ── REQUIRED ──────────────────────────────────────────────
# Must be at least 32 characters.  Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-this-with-a-secure-random-string-of-at-least-32-chars

# Certificate download token lifetimes (seconds)  (defaults: 3600 / 7200)
# Used by POST /api/v1/certification/:id/download-link — see docs/certification/download-links.md
DOWNLOAD_TOKEN_EXPIRY=3600
BULK_DOWNLOAD_TOKEN_EXPIRY=7200

# ─── Email ────────────────────────────────────────────────────────────────────
# Use a Gmail app-password if 2FA is enabled on the account
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM=noreply@chainverse.academy

# SMTP configuration (optional — if omitted, emails are logged but not sent)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# ─── Application base URL ─────────────────────────────────────────────────────
# Used for callback links in emails, etc.  (default: http://localhost:3000)
BASE_URL=http://localhost:3000

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Credentials from Google Cloud Console (optional; Google sign-in is disabled
# without them). CALLBACK_URL must match the authorised redirect URI.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
CALLBACK_URL=http://localhost:3000/auth/google/callback

# ─── Redis (optional – the app degrades gracefully without it) ────────────────
REDIS_URL=redis://localhost:6379
# Set to true to require Redis even when REDIS_URL is absent (default: false)
FORCE_REDIS=false

# ─── Response cache ───────────────────────────────────────────────────────────
# Per-item time-to-live in milliseconds  (default: 300000 = 5 minutes)
CACHE_TTL_MS=300000
# Max items kept in the in-memory store; ignored when Redis is used (default: 1000)
CACHE_MAX_ITEMS=1000

# ─── Rate limiting ────────────────────────────────────────────────────────────
# Master switch; set to false to disable all rate limiting (default: true)
RATE_LIMIT_ENABLED=true

# Window lengths are in milliseconds; *_MAX is the request cap per window.

# Guest (unauthenticated) requests
RATE_LIMIT_GUEST_WINDOW_MS=60000
RATE_LIMIT_GUEST_MAX=30

# Authenticated users
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=100

# Premium users
RATE_LIMIT_PREMIUM_WINDOW_MS=60000
RATE_LIMIT_PREMIUM_MAX=200

# Admin / moderator users
RATE_LIMIT_ADMIN_WINDOW_MS=60000
RATE_LIMIT_ADMIN_MAX=500

# Do not count successful (2xx/3xx) responses against the limit (default: false)
RATE_LIMIT_SKIP_SUCCESS=false
# Do not count failed (4xx/5xx) responses against the limit (default: false)
RATE_LIMIT_SKIP_FAILED=false
# Key prefix for rate-limit counters in the store (default: rl:)
RATE_LIMIT_KEY_PREFIX=rl:
# ─── Stellar ────────────────────────────────────────────────────
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Backend Stellar signing account — keep secret, NEVER commit the real values.
# Generate with: stellar keys generate --network testnet
# STELLAR_BACKEND_SECRET is required in production (app refuses to start without it).
STELLAR_BACKEND_SECRET=S...replace-with-your-secret-key
STELLAR_BACKEND_PUBLIC=G...replace-with-your-public-key

# Contract addresses (populated after deployment)
CONTRACT_ESCROW=
CONTRACT_CERTIFICATES=
CONTRACT_REWARD=
CONTRACT_CHV_TOKEN=
CONTRACT_COURSE_REGISTRY=

# ─── Scholarship disbursements ────────────────────────────────────────────────
# See docs/scholarships/disbursements.md. Payouts fail closed: without a
# treasury secret the executor refuses to run, and without an automation token
# the automation endpoints return 401.
SCHOLARSHIP_TREASURY_SECRET=
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SCHOLARSHIP_AUTOMATION_TOKEN=
SCHOLARSHIP_DISBURSEMENT_CRON_ENABLED=false
SCHOLARSHIP_REQUIRED_CONFIRMATIONS=1
SCHOLARSHIP_BATCH_SIZE=25
SCHOLARSHIP_SUBMISSION_TIMEOUT_SECONDS=180
SCHOLARSHIP_EXPIRY_GRACE_SECONDS=60
SCHOLARSHIP_BASE_FEE_STROOPS=100
SCHOLARSHIP_LEASE_SECONDS=300
SCHOLARSHIP_WALLET_CHALLENGE_TTL_SECONDS=600
SCHOLARSHIP_WALLET_CHALLENGE_MAX_ATTEMPTS=5

# ─── Audit logging (privileged action trail) ──────────────────────────────────
# Dedicated HMAC key for audit-entry integrity hashes. Optional: falls back to
# JWT_SECRET when unset, but set it in production — sharing the key means
# rotating JWT_SECRET invalidates the integrity hash of every historical entry.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUDIT_HMAC_SECRET=

# When true, a failed audit write also fails the mutation being audited.
# Default false: an audit outage does not break privileged operations.
AUDIT_LOG_FAIL_CLOSED=false

# ─── Scholarships: milestone evidence encryption ──────────────────────────────
# Base64-encoded 32-byte AES-256-GCM key for milestone evidence payloads.
# REQUIRED in production. When unset outside production a key is derived from
# JWT_SECRET (with a startup warning). Losing this key makes stored evidence
# unreadable. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# SCHOLARSHIP_EVIDENCE_ENCRYPTION_KEY=
# Identifier stored beside every ciphertext; change it when rotating the key.
SCHOLARSHIP_EVIDENCE_ENCRYPTION_KEY_ID=v1

# ─── Uploads: quarantine, scanning and quotas ─────────────────────────────────
# Storage root for uploaded files. MUST stay outside any web-served directory.
# Files land in <root>/quarantine first and only reach <root>/clean after a scan.
UPLOAD_STORAGE_ROOT=var/uploads

# Maximum accepted size of a single upload, in bytes (default: 5 MiB)
UPLOAD_MAX_FILE_BYTES=5242880

# Per-user quotas: total stored bytes, and file count per rolling window
UPLOAD_QUOTA_MAX_BYTES=104857600
UPLOAD_QUOTA_MAX_FILES=20
UPLOAD_QUOTA_WINDOW_MS=86400000

# Keep infected samples under <root>/infected instead of deleting them.
# Enable only if you have a forensics process; the bytes are still malware.
UPLOAD_RETAIN_INFECTED=false

# Malware scanner backend: builtin | clamav
#   builtin — EICAR + active-content heuristics, no external dependency
#   clamav  — streams uploads to a clamd daemon over TCP (INSTREAM)
MALWARE_SCAN_PROVIDER=builtin
MALWARE_SCAN_HOST=127.0.0.1
MALWARE_SCAN_PORT=3310
MALWARE_SCAN_TIMEOUT_MS=30000

# ─── Webhook security ────────────────────────────────────────────────────────
# Shared secret for verifying incoming webhook HMAC-SHA256 signatures.
# Minimum 16 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=

# Maximum age of a webhook timestamp before it is rejected (default: 300000 = 5 min)
WEBHOOK_TIMESTAMP_TOLERANCE_MS=300000

# ── Mentorship capability (all optional; defaults shown) ─────────────────────
# The capability and its payments are disabled until explicitly enabled.
MENTORSHIP_ENABLED=false
MENTORSHIP_PAYMENTS_ENABLED=false
MENTORSHIP_MAX_ACTIVE_MENTEES_PER_MENTOR=10
MENTORSHIP_MAX_ACTIVE_ENGAGEMENTS_PER_MENTEE=3
# Comma-separated asset codes
MENTORSHIP_SUPPORTED_CURRENCIES=USDC,XLM
MENTORSHIP_SESSION_MIN_MINUTES=15
# Must be >= MENTORSHIP_SESSION_MIN_MINUTES
MENTORSHIP_SESSION_MAX_MINUTES=120
MENTORSHIP_FREE_CANCELLATION_HOURS=24
MENTORSHIP_EVIDENCE_MAX_FILES=5
MENTORSHIP_EVIDENCE_MAX_MB=10
MENTORSHIP_EVIDENCE_RETENTION_DAYS=365
